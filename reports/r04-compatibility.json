  "schema": "browser-image-metadata/r04-compatibility-report@1",
  "semanticDifferences": [
    {
      "id": "date-timezone",
      "incumbent": "exifr may convert dates to Date/UTC; ExifReader retains EXIF lexical values.",
      "toolkit": "Keeps normalized and lexical dates; preserves only an actual EXIF offset and never infers a runtime timezone."
    },
    {
      "id": "rationals",
      "incumbent": "exifr commonly returns decimals; ExifReader exposes numeric pairs.",
      "toolkit": "Keeps normalized numeric values plus exact numerator/denominator source values."
    },
    {
      "id": "duplicates-ordering",
      "incumbent": "Flat object projections cannot represent duplicate candidates or source ordering without an explicit loss policy.",
      "toolkit": "Retains source-ordered fields, RDF properties, IPTC candidates, blocks, and conflicts."
    },
    {
      "id": "raw-semantic",
      "incumbent": "Flat values are convenience projections rather than round-trip models.",
      "toolkit": "Separates raw, lexical, normalized, and semantic values with provenance."
    },
    {
      "id": "warnings-errors",
      "incumbent": "Missing, undefined, null, callback, and thrown-error semantics are library-specific and are not treated as success.",
      "toolkit": "Uses coverage, completeness, typed statuses, diagnostics, and stable reason codes."
    },
    {
      "id": "metadata-families",
      "incumbent": "Unsupported or differently-shaped families remain explicitly non-equivalent.",
      "toolkit": "Preserves distinct EXIF, URI/local-name XMP, IPTC semantic, and ICC families."
    },
    {
      "id": "writing",
      "incumbent": "No broad EXIF-object writer compatibility claim is made.",
      "toolkit": "Uses exact operations, atomic output, reparse, and encoded-payload evidence."
    }
  ],
