    "r05:verify": "node -e \"import('./reports/r05-release-audit.json',{with:{type:'json'}}).then(({default:report})=>import('./scripts/r05-release-audit.mjs').then(({validateReport})=>{validateReport(report); if(report.gate?.passed!==true) throw new Error('R05 report is blocked.'); console.log('R05 release audit verified.');}))\"",
    "release:check": "node scripts/release-check.mjs",
    "baseline": "node scripts/baseline.mjs --output baselines/2.0.0-alpha.3.json",
    "baseline:verify": "node scripts/baseline.mjs --verify baselines/2.0.0-alpha.3.json",
