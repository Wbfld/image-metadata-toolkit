    "test:bun": "bun run build && bun scripts/bun-smoke.mjs",
    "test:corpus": "npm run build && node scripts/external-corpus.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "capabilities:generate": "node scripts/generate-capabilities.mjs",
    "capabilities:check": "node scripts/generate-capabilities.mjs --check",
    "registry:generate": "node scripts/generate-registry.mjs",
    "registry:check": "node scripts/generate-registry.mjs --check",
    "iptc:generate": "node scripts/generate-iptc-semantic.mjs",
    "iptc:check": "node scripts/generate-iptc-semantic.mjs --check",
    "icc:reference": "node scripts/icc-reference-corpus.mjs",
    "iptc:reference": "npm run build && node scripts/iptc-reference-corpus.mjs",
    "creator:g01": "npm run build && node scripts/creator-g01-evidence.mjs",
    "creator:g01:check": "node scripts/creator-g01-evidence.mjs --check",
