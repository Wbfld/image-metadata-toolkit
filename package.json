    "docs:serve": "node docs-site/server.mjs",
    "cli:check": "node scripts/cli-contract.mjs",
    "test:cli": "npm run build && vitest run tests/cli.test.ts",
    "compatibility:generate": "npm run build && node scripts/r04-compatibility.mjs",
    "compatibility:check": "npm run build && node scripts/r04-compatibility.mjs --check",
    "test:r04": "npm run build && vitest run tests/r04-compatibility.test.ts",
    "b09:check": "node scripts/b09-demand-decision.mjs",
    "c2pa:terminology": "node scripts/c2pa-terminology-audit.mjs",
